# Application
APP_NAME=YouTube Copy
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=youtube_copy
POSTGRES_USER=youtube_user
POSTGRES_PASSWORD=change_me_db_password

# Async SQLAlchemy connection
DATABASE_URL=postgresql+asyncpg://youtube_user:change_me_db_password@db:5432/youtube_copy

# MinIO
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ENDPOINT=http://rustfs:9000
MINIO_BUCKET=videos

# MinIO connection for application
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_SECURE=false