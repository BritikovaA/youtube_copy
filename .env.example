# Application
APP_NAME=YouTube Copy
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=youtube_copy
POSTGRES_USER=youtube_user
POSTGRES_PASSWORD=change_me_db_password

DATABASE_HOST_LOCAL=localhost
DATABASE_HOST_DOCKER=db

# JWT Authentication
JWT_SECRET_KEY=replace_with_generated_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RustFS
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password

MINIO_HOST=rustfs
MINIO_PORT=9000
MINIO_ENDPOINT=http://rustfs:9000
MINIO_BUCKET=videos

MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Video upload
MAX_VIDEO_SIZE_MB=2048